{
  "ConnectionStrings": {
    "DBConnectionString": "Server=YOUR_SERVER;Database=Apparcus;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailConfiguration": {
    "SmtpServer": "smtp.example.com",
    "SmtpPort": 465,
    "SmtpUsername": "YOUR_SMTP_USERNAME",
    "CompanyEmail": "support@example.com",
    "SmtpPassword": "YOUR_SMTP_PASSWORD"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "YOUR_JWT_SIGNING_KEY_AT_LEAST_32_CHARS",
    "Issuer": "Apparcus",
    "Audience": "ApparcusMobile",
    "ExpiryMinutes": "10080"
  },
  "SafeHaven": {
    "BaseUrl": "https://api.safehavenmfb.com",
    "ClientId": "YOUR_SAFEHAVEN_CLIENT_ID",
    "DebitAccountNumber": "YOUR_DEBIT_ACCOUNT_NUMBER",
    "PrivateKeyPath": "keys/privatekey.pem"
  },
  "Mono": {
    "BaseUrl": "https://api.withmono.com",
    "SecretKey": "YOUR_MONO_SECRET_KEY",
    "WebhookSecret": "YOUR_MONO_WEBHOOK_SECRET",
    "RedirectUrl": "https://your-domain.com/kyc/complete",
    "KycLevel": "tier_1",
    "InitiatePath": "/v1/prove/initiate",
    "StatusPath": "/v1/prove/{sessionId}"
  }
}
