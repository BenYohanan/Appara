@using Core.ViewModels
@model Core.ViewModels.IPageListModel<ProjectViewModel>
@{
    Layout = ViewBag.Layout;
    ViewData["Title"] = "Disabled Projects";
}

<style>
    body {
        counter-reset: Serial;
    }

    tr td:first-child:before {
        counter-increment: Serial;
        content: counter(Serial);
    }
</style>

<div class="page-wrapper">
    <div class="content">
        <div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
            <div class="my-auto mb-2">
                <h2 class="mb-1">Disabled Projects</h2>
                <nav>
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="javascript:void(0);"><i class="ti ti-smart-home"></i></a>
                        </li>
                        <li class="breadcrumb-item">Dashboard</li>
                        <li class="breadcrumb-item active" aria-current="page">Disabled Projects</li>
                    </ol>
                </nav>
            </div>
        </div>

       
        @await Html.PartialAsync("_PageSearcher", Model)

        <!-- Desktop Table -->
        <div class="d-none d-md-block">
            <div class="card-box">
                <div class="col-md-12">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead class="thead-light">
                                <tr>
                                    <th>S/N</th>
                                    <th>Name</th>
                                    <th>Created By</th>
                                    <th>Account Number</th>
                                    <th>Account Name</th>
                                    <th>Amount Needed</th>
                                    <th>Amount Obtained</th>
                                    <th>Date Created</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Model != null)
                                {
                                    @foreach (var project in Model.Model)
                                    {
                                        <tr>
                                            <td></td>
                                            <td>@project.Name</td>
                                            <td>@project.CreatedBy</td>
                                            <td>@project.AccountNumber</td>
                                            <td>@project.AccountName</td>
                                            <td>@project.AmountNeeded</td>
                                            <td>@project.AmountObtained</td>
                                            <td>@project.DateCreated?.ToString("dd-MMM-yyyy")</td>
                                            @{
                                                var badgeClass = project.Status switch
                                                {
                                                    "Active" => "bg-success",
                                                    "Closed" => "bg-warning text-dark",
                                                    _ => "bg-secondary"
                                                };
                                            }

                                            <td>
                                                <span class="badge @badgeClass text-white d-inline-flex align-items-center">
                                                    <i class="ti ti-point-filled me-1"></i>
                                                    @project.Status
                                                </span>
                                            </td>

                                            <td>
                                                <div class="action-icon d-inline-flex">
                                                    <a href="#" class="text-success" data-bs-toggle="modal" data-bs-target="#restore_project_modal" onclick='confirmDeleteProject(@project.Id)'>
                                                        <i class="ti ti-restore"></i>
                                                    </a>

                                                    <a href="#" class="text-danger" data-bs-toggle="modal" data-bs-target="#delete_project_modal" onclick='confirmDeleteProject(@project.Id)'>
                                                        <i class="ti ti-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-block d-md-none">
            <div class="row">
                @if (Model.Model != null)
                {
                    @foreach (var project in Model.Model)
                    {
                        var badgeClass = project.Status switch
                        {
                            "Active" => "bg-success",
                            "Closed" => "bg-warning text-dark",
                            _ => "bg-secondary"
                        };

                        <div class="col-xxl-3 col-lg-4 col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div>
                                            <h6 class="mb-1">
                                                <a href="project-details.html">@project.Name</a>
                                            </h6>

                                            <span class="badge @badgeClass text-white">
                                                <i class="ti ti-point-filled me-1"></i>
                                                @project.Status
                                            </span>
                                        </div>
                                        <div class="dropdown">
                                            <a href="javascript:void(0);" class="d-inline-flex align-items-center" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="ti ti-dots-vertical"></i>
                                            </a>
                                            <ul class="dropdown-menu dropdown-menu-end p-3">
                                                <li>
                                                    <a href="#" class="dropdown-item rounded-1" onclick='confirmDeleteProject(@project.Id)' data-bs-toggle="modal" data-bs-target="#restore_project_modal"><i class="fa fa-close me-1"></i>Restore</a>
                                                </li>

                                                <li>
                                                    <a href="#" class="dropdown-item rounded-1" onclick='confirmDeleteProject(@project.Id)' data-bs-toggle="modal" data-bs-target="#delete_project_modal"><i class="ti ti-trash me-1"></i>Delete</a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                                        <div class="d-flex align-items-center file-name-icon">
                                            <a href="javascript:void(0);" class="avatar avatar-sm avatar-rounded flex-shrink-0">
                                                <img src="~/template/assets/img/users/user-39.jpg" class="img-fluid" alt="img">
                                            </a>
                                            <div class="ms-2">
                                                <h6 class="fw-normal fs-12"><a href="javascript:void(0);">@project.CreatedBy</a></h6>
                                                <span class="fs-12 fw-normal">Account Number: @project.AccountNumber</span><br />
                                                <span class="fs-12 fw-normal">Account Name: @project.AccountName</span><br />
                                                <span class="fs-12 fw-normal">Date Created: @project.DateCreated?.ToString("dd-MM-yyyy")</span><br />
                                            </div>
                                        </div>
                                    </div>

                                    @{
                                        var needed = project.AmountNeeded;
                                        var obtained = project.AmountObtained;
                                        var pct = needed > 0 ? Math.Min(100, (int)Math.Round((obtained / needed) * 100)) : 0;
                                    }
                                    <div class="mb-3">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="fs-12 fw-medium text-dark">₦@obtained.ToString("N0") raised</span>
                                            <span class="fs-12 text-muted">of ₦@needed.ToString("N0")</span>
                                        </div>
                                        <div class="progress" style="height:6px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width:@(pct)%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                <div class="col-md-12">
                    <div class="text-center mb-4">
                        <a href="#" class="btn btn-primary"><i class="ti ti-loader-3 me-1"></i>Load More</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
    @await Html.PartialAsync("_Pager", Model?.Model)
</div>

<!-- Activate Modal -->
<div class="modal fade" id="restore_project_modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center">
                <span class="avatar avatar-xl bg-transparent-success text-success mb-3">
                    <i class="fa fa-close fs-36"></i>
                </span>
                <h4 class="mb-1">Confirm Restore</h4>
                <p class="mb-3">Are you sure you want to restore this project?</p>
                <input type="hidden" id="activate_projectId">
                <div class="d-flex justify-content-center">
                    <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" id="close_submit_btn"  onclick="updateProject('Active','activate_projectId','close_submit_btn','restore_project_modal')">Yes, Restore</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /Activate Modal -->
<!-- Delete Modal -->
<div class="modal fade" id="delete_project_modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center">
                <span class="avatar avatar-xl bg-transparent-danger text-danger mb-3">
                    <i class="ti ti-trash-x fs-36"></i>
                </span>
                <h4 class="mb-1">Confirm Delete</h4>
                <p class="mb-3">Are you sure you want to delete this project? This cannot be undone.</p>
                <input type="hidden" id="delete_projectId">
                <div class="d-flex justify-content-center">
                    <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="delete_submit_btn" onclick="deleteProject()">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /Delete Modal -->