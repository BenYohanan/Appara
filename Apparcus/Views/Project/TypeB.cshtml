@using Core.ViewModels
@model Core.ViewModels.IPageListModel<ProjectViewModel>
@{
    Layout = ViewBag.Layout;
    ViewData["Title"] = "Type-B Records";
    var quota = (RecordQuotaStatus)ViewBag.RecordQuota;
}

<div class="page-wrapper">
    <div class="content">
        <div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
            <div class="my-auto mb-2">
                <h2 class="mb-1">Type-B Records</h2>
                <nav>
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="javascript:void(0);"><i class="ti ti-smart-home"></i></a></li>
                        <li class="breadcrumb-item">Dashboard</li>
                        <li class="breadcrumb-item active" aria-current="page">Type-B</li>
                    </ol>
                </nav>
            </div>
            <div class="d-flex my-xl-auto right-content align-items-center flex-wrap">
                <div class="mb-2">
                    <a data-bs-toggle="modal" data-bs-target="#add_type_b" class="btn btn-primary d-flex align-items-center">
                        <i class="ti ti-circle-plus me-2"></i>Add Type-B Project
                    </a>
                </div>
            </div>
        </div>

        <div class="card border-primary mb-4 shadow-sm">
            <div class="card-body d-md-flex align-items-center justify-content-between">
                <div>
                    <h6 class="mb-1 text-dark">
                        @quota.Used.ToString("N0") of @quota.Quota.ToString("N0") records used
                    </h6>
                    <p class="mb-0 text-muted">
                        Keep your payment records safe on Apparcus &mdash; reachable from anywhere, and
                        shareable with a link. Records are bought in packs
                        (@string.Join(", ", quota.Packs.Select(p => $"{p.Size:N0} for ₦{p.PriceNaira:N0}"))),
                        counted across all your Type-B projects together.
                    </p>
                </div>
                <div class="mt-3 mt-md-0 text-md-end">
                    <span class="badge @(quota.Remaining > 0 ? "badge-soft-success" : "badge-soft-danger") mb-2 d-block">
                        @quota.Remaining.ToString("N0") left
                    </span>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#buy_records">
                        Protect more records
                    </button>
                </div>
            </div>
        </div>

        @await Html.PartialAsync("_PageSearcher", Model)

        @if (!Model.Model.Any())
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-list-details text-muted" style="font-size: 48px;"></i>
                    <h5 class="mt-3 mb-1">No Type-B project yet</h5>
                    <p class="text-muted mb-0">
                        Create one to start typing up a record sheet you already have on paper.
                    </p>
                </div>
            </div>
        }
        else
        {
            @* A record sheet has several figures per row, which a phone cannot
               show side by side without either scrolling sideways or shrinking
               past reading size. Cards below md, the table above it. *@
            <div class="d-none d-md-block">
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Title</th>
                                        <th>Date</th>
                                        <th>Records</th>
                                        <th>Amount Obtained</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var project in Model.Model)
                                    {
                                        <tr>
                                            <td></td>
                                            <td>
                                                <span class="fw-medium">@project.Name</span>
                                                @if (project.IsPublic)
                                                {
                                                    <span class="badge badge-soft-info ms-1">Public</span>
                                                }
                                            </td>
                                            <td>@(project.CustomDate?.ToString("dd MMM yyyy") ?? project.DateCreated?.ToString("dd MMM yyyy"))</td>
                                            <td>@project.RecordCount.ToString("N0")</td>
                                            <td>₦@project.AmountObtained.ToString("N2")</td>
                                            <td>
                                                <span class="badge @(project.Status == "Active" ? "bg-success" : "bg-warning text-dark")">
                                                    @project.Status
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="dropdown">
                                                    <a href="javascript:void(0);" class="btn btn-sm btn-outline-light border" data-bs-toggle="dropdown">
                                                        <i class="ti ti-dots-vertical"></i>
                                                    </a>
                                                    @await Html.PartialAsync("_TypeBProjectActions", project)
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-block d-md-none">
                @foreach (var project in Model.Model)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="pe-2">
                                    <h6 class="mb-1">@project.Name</h6>
                                    <span class="badge @(project.Status == "Active" ? "bg-success" : "bg-warning text-dark")">
                                        @project.Status
                                    </span>
                                    @if (project.IsPublic)
                                    {
                                        <span class="badge badge-soft-info ms-1">Public</span>
                                    }
                                </div>
                                <div class="dropdown flex-shrink-0">
                                    <a href="javascript:void(0);" class="d-inline-flex align-items-center" data-bs-toggle="dropdown">
                                        <i class="ti ti-dots-vertical"></i>
                                    </a>
                                    @await Html.PartialAsync("_TypeBProjectActions", project)
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between border-top pt-2">
                                <span class="fs-12 text-muted">Date</span>
                                <span class="fs-12 fw-medium">
                                    @(project.CustomDate?.ToString("dd MMM yyyy") ?? project.DateCreated?.ToString("dd MMM yyyy"))
                                </span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between border-top pt-2 mt-2">
                                <span class="fs-12 text-muted">Records</span>
                                <span class="fs-12 fw-medium">@project.RecordCount.ToString("N0")</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between border-top pt-2 mt-2">
                                <span class="fs-12 text-muted">Amount Obtained</span>
                                <span class="fs-12 fw-medium">₦@project.AmountObtained.ToString("N2")</span>
                            </div>

                            <a href="javascript:void(0);" class="btn btn-sm btn-outline-primary w-100 mt-3"
                               onclick="openAddRecord(@project.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(project.Name)))"
                               data-bs-toggle="modal" data-bs-target="#add_record">
                                <i class="ti ti-circle-plus me-1"></i>Add Record
                            </a>
                        </div>
                    </div>
                }
            </div>

            @await Html.PartialAsync("_Pager", Model.Model)
        }
    </div>
</div>

@await Html.PartialAsync("_TypeBModals", quota)

@section Scripts {
    <script src="~/js/typeb.js?v=@DateTime.Now.Ticks"></script>
}
