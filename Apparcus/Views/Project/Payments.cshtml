@model Core.ViewModels.IPageListModel<Core.ViewModels.PaymentDTO>
@{
    ViewData["Title"] = "Payments";
    Layout = ViewBag.Layout;
    var projectId = ViewBag.ProjectId != null ? Convert.ToInt32(ViewBag.ProjectId) : 0;

    var transactionPinSet = ViewBag.TransactionPin;
}

<style>
    body {
        counter-reset: Serial;
    }

    tr td:first-child:before {
        counter-increment: Serial;
        content: counter(Serial);
    }
</style>

<div class="page-wrapper">
    <div class="content">
        <div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
            <div class="my-auto mb-2">
                <h2 class="mb-1">Payments for "@ViewBag.ProjectName"</h2>
                <nav>
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="javascript:void(0);"><i class="ti ti-smart-home"></i></a></li>
                        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Project">Projects</a></li>
                        <li class="breadcrumb-item active">Payments</li>
                    </ol>
                </nav>
            </div>
            <div class="d-flex my-xl-auto right-content align-items-center flex-wrap">
                <a asp-action="Index" asp-controller="Project" class="btn btn-primary">
                    <i class="ti ti-arrow-left me-2"></i>Back to Projects
                </a>
            </div>
        </div>

        @if (!transactionPinSet)
        {
            <div class="card border-primary mb-4 shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between">

                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <span class="avatar avatar-md bg-primary text-white rounded-circle">
                                <i class="ti ti-shield-check fs-20"></i>
                            </span>
                        </div>

                        <div>
                            <h6 class="mb-1 text-dark">Transaction PIN Required</h6>
                            <p class="mb-0 text-muted">
                                Please set a transaction PIN.
                            </p>
                        </div>
                    </div>

                    <div>
                        <a href="javascript:void(0)"
                           data-bs-toggle="modal"
                           data-bs-target="#setTransactionPinModal"
                           class="btn btn-primary btn-sm">
                            Set PIN
                        </a>
                    </div>

                </div>
            </div>
        }

        @{
            var totalAmount = ViewBag.TotalCollected ?? 0m;
            var balance = ViewBag.Balance ?? 0m;
            var hasPayments = totalAmount > 0;
            var formattedTotal = ((decimal)totalAmount).ToString("N0");
            var formattedBalance = ((decimal)balance).ToString("N0");
        }
        <div class="alert alert-success d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex flex-column">
                <div>
                    <strong>Total Collected:</strong>
                    <span class="fs-3 fw-bold">₦@formattedTotal</span>
                </div>

                <div>
                    <strong>Balance:</strong>
                    <span class="fs-3 fw-bold text-danger">₦@formattedBalance</span>
                </div>
            </div>

            <div class="ms-auto">
                <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#withdrawModal"
                        data-project-id="@projectId">
                    Withdraw Funds
                </button>
            </div>

        </div>

        @await Html.PartialAsync("_PageSearcher", Model)

        <div class="card-box d-none d-md-block">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead class="thead-light">
                        <tr>
                            <th>S/N</th>
                            <th>Reference</th>
                            <th>Contributor</th>
                            <th>Contributor Phone</th>
                            <th>Date</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Model?.Any() == true)
                        {
                            foreach (var p in Model.Model)
                            {
                                <tr>
                                    <td></td>
                                    <td><code class="text-muted small">@p.Reference</code></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span>@p.Contributor</span>
                                        </div>
                                    </td>
                                    <td>@p.ContributorPhone</td>
                                    <td>@p.PaymentDate?.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge bg-success">₦@p.AmountPaid?.ToString("N0")</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Mobile Cards -->
        <div class="d-block d-md-none">
            <div class="row">
                @if (Model.Model?.Any() == true)
                {
                    foreach (var p in Model.Model)
                    {
                        <div class="col-12 mb-3">
                            <div class="card shadow-sm">
                                <div class="card-body">

                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <h6 class="mb-0">@p.Contributor</h6>
                                            <p class="mb-0">@p.ContributorPhone</p>
                                            <small class="text-muted">@p.PaymentDate?.ToString("dd MMM yyyy")</small>
                                        </div>

                                        <span class="badge bg-success fs-6">
                                            ₦@p.AmountPaid?.ToString("N0")
                                        </span>
                                    </div>

                                    <hr>

                                    <small class="text-muted d-block mb-3">
                                        <strong>Ref:</strong> @p.Reference
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="mt-4">
            @await Html.PartialAsync("_Pager", Model.Model)
        </div>
    </div>
</div>


@await Html.PartialAsync("_WithdrawModal", (int)projectId)
@await Html.PartialAsync("_SetTransactionPinModal")
@await Html.PartialAsync("_BuyBeadsModal")