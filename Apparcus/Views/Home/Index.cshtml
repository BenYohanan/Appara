<style>
    .hero-search { max-width: 620px; margin: 0 auto 26px; position: relative; text-align: left; }

    .hero-search-box {
        display: flex; align-items: center; gap: 12px;
        background: rgba(255, 255, 255, .97);
        border-radius: 999px; padding: 6px 8px 6px 22px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, .28);
    }

    .hero-search-box i { color: #6b7280; font-size: 18px; flex: none; }

    .hero-search-box input {
        flex: 1; border: 0; outline: 0; background: transparent;
        font-size: 16px; padding: 14px 0; color: #15161e; min-width: 0;
    }

    .hero-search-box input::placeholder { color: #9ca3af; }

    .hero-search-box input:focus-visible { outline: 0; }
    .hero-search-box:focus-within { box-shadow: 0 0 0 3px rgba(147, 51, 234, .45), 0 12px 40px rgba(0, 0, 0, .28); }

    .hero-search-spinner {
        width: 18px; height: 18px; margin-right: 14px; flex: none;
        border: 2px solid #e5e7eb; border-top-color: #9333ea;
        border-radius: 50%; animation: heroSpin .7s linear infinite;
    }

    @@keyframes heroSpin { to { transform: rotate(360deg); } }
    @@media (prefers-reduced-motion: reduce) { .hero-search-spinner { animation-duration: 2s; } }

    .hero-search-hint { color: rgba(255, 255, 255, .82); font-size: 13.5px; margin: 10px 4px 0; }

    .hero-search-results {
        position: absolute; left: 0; right: 0; top: calc(100% + 8px); z-index: 30;
        background: #fff; border-radius: 16px; overflow: hidden auto; max-height: 340px;
        box-shadow: 0 18px 50px rgba(0, 0, 0, .3); text-align: left;
    }

    .hero-result {
        display: block; padding: 14px 20px; border-bottom: 1px solid #f0f0f5;
        text-decoration: none; color: inherit;
    }

    .hero-result:last-child { border-bottom: 0; }
    .hero-result:hover, .hero-result:focus-visible { background: #faf5ff; outline: none; }

    .hero-result-name { font-weight: 600; font-size: 15px; color: #15161e; }
    .hero-result-desc { font-size: 13px; color: #6b7280; margin: 3px 0 0; }
    .hero-result-meta { font-size: 12.5px; color: #9333ea; margin: 6px 0 0; font-weight: 600; }
    .hero-result-empty { padding: 18px 20px; color: #6b7280; font-size: 14px; }
</style>

<script>
    (function () {
        var input    = document.getElementById('projectSearch');
        var results  = document.getElementById('projectSearchResults');
        var spinner  = document.getElementById('projectSearchSpinner');
        if (!input || !results) return;

        var timer = null;
        var lastQuery = '';
        var naira = new Intl.NumberFormat('en-NG', { style: 'currency', currency: 'NGN', maximumFractionDigits: 0 });

        function close() {
            results.hidden = true;
            results.innerHTML = '';
            input.setAttribute('aria-expanded', 'false');
        }

        function escapeHtml(value) {
            return String(value == null ? '' : value)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function render(items) {
            if (!items.length) {
                results.innerHTML = '<p class="hero-result-empty">No public project matches that name.</p>';
            } else {
                results.innerHTML = items.map(function (p) {
                    // A code-protected project comes back without its figures.
                    // Say a code is needed instead of rendering a false zero.
                    // A record sheet is raising towards nothing, so there is no
                    // target to show progress against.
                    var meta = p.hasAccessCode
                        ? 'Code required &mdash; ask your project rep'
                        : p.type === 'B'
                            ? 'Record sheet &mdash; ' + naira.format(p.amountObtained || 0) + ' recorded'
                            : naira.format(p.amountObtained || 0) + ' raised of ' + naira.format(p.amountNeeded || 0);

                    return '<a class="hero-result" role="option" href="' + escapeHtml(p.url) + '">' +
                           '<span class="hero-result-name">' + escapeHtml(p.name) + '</span>' +
                           (p.description ? '<p class="hero-result-desc">' + escapeHtml(p.description) + '</p>' : '') +
                           '<p class="hero-result-meta">' + meta + '</p>' +
                           '</a>';
                }).join('');
            }
            results.hidden = false;
            input.setAttribute('aria-expanded', 'true');
        }

        function search(query) {
            spinner.hidden = false;

            fetch('/Guest/Search?q=' + encodeURIComponent(query), { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (body) {
                    // A slow response for an old query must not overwrite a newer one.
                    if (query !== lastQuery) return;
                    render((body && body.data) || []);
                })
                .catch(function () {
                    if (query !== lastQuery) return;
                    results.innerHTML = '<p class="hero-result-empty">Search is unavailable right now. Please try again.</p>';
                    results.hidden = false;
                })
                .finally(function () { spinner.hidden = true; });
        }

        input.addEventListener('input', function () {
            var query = input.value.trim();
            lastQuery = query;
            clearTimeout(timer);

            // Two characters is the floor — one letter matches nearly everything
            // and just leaks the catalogue.
            if (query.length < 2) { spinner.hidden = true; close(); return; }

            timer = setTimeout(function () { search(query); }, 250);
        });

        input.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { close(); input.blur(); }
            if (e.key === 'ArrowDown' && !results.hidden) {
                var first = results.querySelector('.hero-result');
                if (first) { e.preventDefault(); first.focus(); }
            }
        });

        document.addEventListener('click', function (e) {
            if (!results.hidden && !results.contains(e.target) && e.target !== input) close();
        });
    })();
</script>
