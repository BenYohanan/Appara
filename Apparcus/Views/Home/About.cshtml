@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "About";
}

<!-- PAGE HERO -->
<section class="about-hero position-relative overflow-hidden">
    <div class="about-hero-bg"></div>
    <div class="container position-relative text-center py-5 px-3">
        <span class="subtitle" data-aos="fade-up">Who We Are</span>
        <h1 class="about-hero-title fw-bold mt-2" data-aos="fade-up" data-aos-delay="100">
            The Science of <span style="color:#9333ea">Group Harmony</span>
        </h1>
        <p class="about-hero-lead text-muted mx-auto mt-3" data-aos="fade-up" data-aos-delay="200">
            At Apparcus, we believe that group projects should bring people together—not pull them apart over "lost alerts" or manual record-keeping.
        </p>
    </div>
</section>

<!-- INTRO BLOCK -->
<section class="py-4 py-lg-5">
    <div class="container px-3">
        <!-- Mobile-only icon banner -->
        <div class="about-intro-icon-wrap rounded-4 text-center mb-4 d-lg-none" data-aos="fade-up">
            <i class="bi bi-people-fill about-section-icon" style="color:#9333ea;"></i>
            <p class="mt-2 fw-semibold mb-0" style="color:#6b21a8;">Built for the Collective</p>
        </div>
        <div class="row align-items-center g-4 g-lg-5">
            <!-- Desktop-only full icon block -->
            <div class="col-lg-6 d-none d-lg-block" data-aos="fade-right">
                <div class="about-icon-block p-5 rounded-4 text-center" style="background:linear-gradient(135deg,#f3e8ff,#ede9fe);">
                    <i class="bi bi-people-fill" style="font-size:6rem;color:#9333ea;"></i>
                    <p class="mt-3 fw-semibold fs-5 mb-0" style="color:#6b21a8;">Built for the Collective</p>
                </div>
            </div>
            <div class="col-12 col-lg-6" data-aos="fade-left">
                <h2 class="about-section-heading fw-bold mb-3">More Than a Payment App</h2>
                <p class="text-muted">
                    While most financial apps are built for individuals, <strong>Apparcus was built for the Collective</strong>. We recognized that in the culture of alumni associations, wedding committees, and group projects, "Free" often comes at a high psychological cost: the stress of manual tracking, the awkwardness of asking for receipts, and the friction of "missing" bank alerts.
                </p>
                <p class="text-muted mt-3">
                    We solve the problem that matters most — keeping group friendships intact while making leaders look professional and organized.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ABACUS PHILOSOPHY -->
<section class="py-4 py-lg-5 bg-light">
    <div class="container px-3">
        <!-- Mobile-only icon banner -->
        <div class="about-intro-icon-wrap rounded-4 text-center mb-4 d-lg-none" style="background:linear-gradient(135deg,#fff7ed,#fef3c7);" data-aos="fade-up">
            <i class="bi bi-calculator-fill about-section-icon" style="color:#d97706;"></i>
            <p class="mt-2 fw-semibold mb-0" style="color:#92400e;">Transparency is Timeless</p>
        </div>
        <div class="row align-items-center g-4 g-lg-5 flex-lg-row-reverse">
            <!-- Desktop-only full icon block -->
            <div class="col-lg-6 d-none d-lg-block" data-aos="fade-left">
                <div class="about-icon-block p-5 rounded-4 text-center" style="background:linear-gradient(135deg,#fff7ed,#fef3c7);">
                    <i class="bi bi-calculator-fill" style="font-size:6rem;color:#d97706;"></i>
                    <p class="mt-3 fw-semibold fs-5 mb-0" style="color:#92400e;">Transparency is Timeless</p>
                </div>
            </div>
            <div class="col-12 col-lg-6" data-aos="fade-right">
                <span class="subtitle">Our Name, Our Philosophy</span>
                <h2 class="about-section-heading fw-bold mt-2 mb-3">The Abacus Philosophy</h2>
                <p class="text-muted">
                    Our name—a fusion of the modern <strong>"App"</strong> and the ancient <strong>"Abacus"</strong>—represents our core belief that transparency is timeless. The Abacus is the world's first tool for honest counting. With that same uncompromising honesty brought into the digital age, Apparcus doesn't just move funds; we provide the <strong>"Third-Party Truth"</strong> that keeps group friendships intact and leaders organized.
                </p>
                <p class="text-muted mt-3">
                    Through our exclusive <strong>Priority Transaction Rail</strong>—backed by our strategic partnership with Safe Haven Microfinance Bank (SHMFB)—we offer a premium service standard. We charge a small service fee because we refuse to compromise on the speed and certainty of your group's funds.
                </p>
                <div class="mt-4 p-3 rounded-3" style="background:#f3e8ff;border-left:4px solid #9333ea;">
                    <p class="mb-0 fst-italic" style="color:#6b21a8;font-size:0.95rem;">
                        "When a project is important, 'Free' is a risk you can't afford. Apparcus is the Safe Haven for your group's ambitions."
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- PILLARS OF TRUST -->
<section class="py-4 py-lg-5">
    <div class="container px-3">
        <div class="section-title text-center mb-4 mb-lg-5" data-aos="fade-up">
            <span class="subtitle">What Sets Us Apart</span>
            <h2 class="about-section-heading fw-bold mt-1">Our Pillars of Trust</h2>
            <p class="text-muted">The foundations on which every group collection is built.</p>
        </div>
        <div class="row g-3 g-lg-4">
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="pillar-card p-3 p-lg-4 rounded-4 h-100 d-flex gap-3 align-items-start">
                    <div class="pillar-num flex-shrink-0">01</div>
                    <div>
                        <h5 class="fw-semibold mb-2 fs-6">Identity-First Verification</h5>
                        <p class="text-muted mb-0 small">We solve the <em>"Who sent this?"</em> problem before it even starts. Every contributor is verified upfront, removing ambiguity from your records entirely.</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="pillar-card p-3 p-lg-4 rounded-4 h-100 d-flex gap-3 align-items-start">
                    <div class="pillar-num flex-shrink-0">02</div>
                    <div>
                        <h5 class="fw-semibold mb-2 fs-6">Social Clearance</h5>
                        <p class="text-muted mb-0 small">We provide members with instant digital "checks" that confirm their contribution to the entire group in real-time. No more awkward follow-ups.</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="pillar-card p-3 p-lg-4 rounded-4 h-100 d-flex gap-3 align-items-start">
                    <div class="pillar-num flex-shrink-0">03</div>
                    <div>
                        <h5 class="fw-semibold mb-2 fs-6">Automated Governance</h5>
                        <p class="text-muted mb-0 small">We turn the volunteer role of "Financial Secretary" into a professional, audit-ready operation with zero manual effort.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- VISION -->
<section class="py-4 py-lg-5" style="background:linear-gradient(135deg,#1e1b4b,#4c1d95);">
    <div class="container px-3 text-center text-white" data-aos="fade-up">
        <span class="subtitle" style="color:#c4b5fd;">Our Vision</span>
        <h2 class="about-section-heading fw-bold mt-2 mb-3">Building a World Without Wahala</h2>
        <p class="mx-auto mb-4" style="max-width:680px;opacity:0.85;font-size:0.95rem;">
            To be the institutional standard for how groups coordinate, contribute, and succeed. We are building a world where group collection is no longer a source of Wahala, but a system for collective progress.
        </p>
        <div class="row g-3 justify-content-center mt-2">
            <div class="col-12 col-sm-6 col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="vision-stat p-3 p-lg-4 rounded-4">
                    <i class="bi bi-currency-exchange fs-2 mb-2 d-block" style="color:#c4b5fd;"></i>
                    <h6 class="fw-bold text-white mb-1" style="font-size:0.9rem;">Every Kobo Accounted For</h6>
                    <p style="opacity:0.75;font-size:0.82rem;" class="mb-0">On the Organized Group Ledger, nothing goes missing.</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="vision-stat p-3 p-lg-4 rounded-4">
                    <i class="bi bi-person-check-fill fs-2 mb-2 d-block" style="color:#c4b5fd;"></i>
                    <h6 class="fw-bold text-white mb-1" style="font-size:0.9rem;">Every Member Verified</h6>
                    <p style="opacity:0.75;font-size:0.82rem;" class="mb-0">Identity-first so the group always knows who contributed.</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="vision-stat p-3 p-lg-4 rounded-4">
                    <i class="bi bi-folder-check fs-2 mb-2 d-block" style="color:#c4b5fd;"></i>
                    <h6 class="fw-bold text-white mb-1" style="font-size:0.9rem;">Every Project Organized</h6>
                    <p style="opacity:0.75;font-size:0.82rem;" class="mb-0">From launch to payout — structured, transparent, professional.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-4 py-lg-5 bg-light">
    <div class="container px-3 text-center" data-aos="fade-up">
        <h3 class="about-section-heading fw-bold mb-3">Ready to Run Your Next Group Project the Right Way?</h3>
        <p class="text-muted mb-4">Join thousands of Nigerians already using Apparcus to manage group collections with zero stress.</p>
        <div class="d-grid d-sm-block">
            <a href="/Account/Register" class="btn btn-primary btn-lg px-5">Get Started Free</a>
        </div>
    </div>
</section>

<style>
    .about-hero {
        background: #f9fafb;
        border-bottom: 1px solid #ede9fe;
        padding-top: 3rem;
        padding-bottom: 2.5rem;
    }

    .about-hero-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 60% 40%, rgba(147,51,234,0.07) 0%, transparent 70%);
        pointer-events: none;
    }

    .about-hero-title {
        font-size: clamp(1.6rem, 6vw, 3rem);
        line-height: 1.2;
    }

    .about-hero-lead {
        font-size: clamp(0.92rem, 3vw, 1.1rem);
    }

    .about-section-heading {
        font-size: clamp(1.2rem, 4.5vw, 2rem);
        line-height: 1.3;
    }

    .about-intro-icon-wrap {
        background: linear-gradient(135deg, #f3e8ff, #ede9fe);
        padding: 1.5rem 1rem;
    }

    .about-section-icon {
        font-size: 3.5rem;
    }

    .pillar-card {
        background: #fff;
        border: 1px solid #ede9fe;
        box-shadow: 0 4px 15px rgba(0,0,0,0.04);
        transition: all 0.3s ease;
    }

    .pillar-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(147,51,234,0.1);
        border-color: #9333ea;
    }

    .pillar-num {
        font-size: 1.8rem;
        font-weight: 800;
        color: #ede9fe;
        line-height: 1;
        min-width: 44px;
        transition: color 0.3s ease;
    }

    .pillar-card:hover .pillar-num {
        color: #9333ea;
    }

    .vision-stat {
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.12);
        transition: all 0.3s ease;
    }

    .vision-stat:hover {
        background: rgba(255,255,255,0.13);
        transform: translateY(-4px);
    }

   

    .subtitle {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #9333ea;
    }
</style>