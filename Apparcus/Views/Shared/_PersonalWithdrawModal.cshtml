<div class="modal fade" id="personalWithdrawModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Withdraw from Personal Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="personalWithdrawSessionId" value="">

                <div class="mb-3">
                    <label class="form-label">Select Bank</label>
                    <select style="width:100%;" onchange="verifyPersonalWithdrawAccount()" id="personalWithdrawBankCode" asp-items="@(new SelectList(ViewBag?.Banks, "code", "name"))" class="form-control select2"></select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Account Number (10 digits)</label>
                    <input type="text" id="personalWithdrawAccountNumber" onchange="verifyPersonalWithdrawAccount()" class="form-control" placeholder="Enter 10-digit account number" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Account Name</label>
                    <input type="text" id="personalWithdrawAccountHolderName" class="form-control" disabled readonly placeholder="Will auto-fill after verification">
                </div>

                <div class="mb-3">
                    <label class="form-label">Amount (₦)</label>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <small class="text-muted">
                            Available: ₦<span id="personalWithdrawBalanceDisplay">--</span>
                        </small>
                        <button type="button" class="btn btn-link btn-sm p-0" id="personalWithdrawAllBtn">
                            Withdraw all
                        </button>
                    </div>
                    <input type="number" id="personalWithdrawAmount" class="form-control" min="0" step="0.01" placeholder="Enter amount to withdraw" required>
                    <small id="personalWithdrawAmountPreview" class="form-text d-block mt-1" style="display:none;"></small>
                </div>

                <div id="personalWithdrawConsentBox" class="form-check mb-3 d-none">
                    <input class="form-check-input" type="checkbox" id="personalWithdrawConsentCheckbox">
                    <label class="form-check-label small" for="personalWithdrawConsentCheckbox">
                        I understand a portion of this withdrawal will be deducted to cover the bank charge, and I want to proceed.
                    </label>
                </div>

                <div class="mb-3">
                    <label class="form-label">Transaction PIN</label>
                    <input type="password" class="form-control" id="personalWithdrawTransactionPin" maxlength="6" pattern="[0-9]{6}" placeholder="Enter 6-digit PIN" oninput="this.value=this.value.replace(/[^0-9]/g,'')" required>
                </div>

                <button type="button" onclick="personalWithdraw()" class="btn btn-primary w-100" id="personalWithdrawBtn">
                    Withdraw
                </button>
            </div>
        </div>
    </div>
</div>